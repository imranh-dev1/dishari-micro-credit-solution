model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      Role       @default(BRANCH_MANAGER)
  status    UserStatus @default(ACTIVE)
  gender    Gender?
  employee  Employee?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("users")
}
