model Employee {
    id          String   @id @default(uuid())
    email       String   @unique
    name        String
    fotherName  String
    motherName  String
    phone       String
    address     String
    nationalID  String   @unique
    designation String
    salary      Float
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    User        User?

    @@map("employees")
}
